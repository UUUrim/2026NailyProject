# 손 촬영 화면이 붙는 스캔 서버(scan/server.py) 주소.
# Backend의 application.yml에 있는 analysis.server.url과 반드시 같은 포트여야 한다.
VITE_SCAN_SERVER_URL=http://localhost:8003

# 폰이 접속하는 카메라 페이지 주소 (localhost는 폰에서 못 엶 - ngrok 등 외부 도달 가능한 주소 필요).
# ngrok http 8003 실행할 때마다 바뀌므로 새로 열 때마다 업데이트해야 함.
